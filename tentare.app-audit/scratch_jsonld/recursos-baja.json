      "data": {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿Y si ninguna instructora puede cubrirla?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Te avisa enseguida con las opciones sobre la mesa: reprogramar, cancelar avisando a las alumnas, o cubrir tú. Nunca te deja descubrir el hueco a última hora."
            }
          },
          {
            "@type": "Question",
            "name": "¿La instructora tiene que instalar una app?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Avisa de su baja desde un enlace en el móvil, sin instalar ni crear cuenta. Cuanto más fácil sea avisar, antes te enteras."
            }
          },
          {
            "@type": "Question",
            "name": "¿Puedo seguir aprobando cada sustitución?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Claro. En modo asistido apruebas cada candidata con un toque. Solo pasas a autónomo cuando tú quieras."
            }
          }
        ]
      }
    },
