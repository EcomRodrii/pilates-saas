@@ -0,0 +1,29 @@
+-- AUDITORÍA 21ª pasada (2-sep) · F-15 🟡 (defensa en profundidad)
+--
+-- Estas tres tablas tienen RLS activado y CERO policies —o sea, hoy deniegan
+-- todo a `authenticated`— pero conservan un GRANT completo de la época en que
+-- se pensaba leerlas desde el navegador. Todo su acceso real pasa hoy por
+-- service-role (app/api/network/resenas, app/api/interno/network/resenas,
+-- lib/network/publico.ts, el motor de notificaciones), verificado con grep: no
+-- hay ni un `.from('red_resenas')` con el cliente de navegador.
+--
+-- El riesgo no es hoy, es el día que alguien añada UNA policy permisiva "para
+-- que funcione una cosita": el GRANT ya está puesto y el radio de explosión
+-- sería CRUD completo, incluido `update red_resenas.estado` (auto-publicarse
+-- una reseña que está en moderación) y `delete`. El patrón correcto ya existe
+-- al lado: `socio_companeras` no tiene ningún grant.
+--
+-- Revocar no cambia NADA del comportamiento actual (RLS sin policies ya
+-- deniega); solo desarma el privilegio para que el fallo futuro sea imposible
+-- en vez de estar a una policy de distancia.
+
+revoke all on table public.red_resenas from authenticated;
+revoke all on table public.notification_delivery from authenticated;
+revoke all on table public.review_boost_recompensas from authenticated;
+
+-- `webhook_disputas` y `webhook_reembolsos` estaban SIN RLS. Hoy es inocuo
+-- (tampoco tienen grants, así que PostgREST deniega en la capa de GRANT antes
+-- de que RLS importe), pero deja el proyecto en rojo en los advisors y depende
+-- de que nadie conceda un grant por costumbre. Se activa, que es gratis.
+alter table public.webhook_disputas enable row level security;
+alter table public.webhook_reembolsos enable row level security;
