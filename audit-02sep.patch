@@ -0,0 +1,27 @@
+-- AUDITORÍA 21ª pasada (2-sep) · F-1 🔴
+--
+-- La migración 20260902001721 añadió `venta_pos_id` con este CHECK:
+--     check ((recibo_id is not null) <> (venta_pos_id is not null))
+-- es decir, "exactamente uno de los dos". Pero una factura RECTIFICATIVA no
+-- cuelga de ningún recibo: `sellarFacturaDeRecibo` llama a
+-- `reservar_numero_factura` con `p_recibo_id => null` (lib/billing/
+-- sellar-factura-server.ts), y esa RPC nunca escribe `venta_pos_id`. Con los
+-- dos a NULL el XOR es false → 23514, así que TODA rectificativa falla desde
+-- el 2-sep con "No se ha podido reservar el número de la rectificativa".
+--
+-- No se detectó al desplegar porque hoy hay 0 rectificativas en producción
+-- (24 facturas, todas de serie A y todas con recibo_id): el constraint se
+-- validó limpio sobre datos que nunca ejercitan el caso roto.
+--
+-- La invariante REAL que se quería expresar es "nunca las dos a la vez", no
+-- "exactamente una". Se relaja a eso, que además deja pasar la rectificativa.
+-- Ninguna fila existente queda fuera (comprobado: 0 con las dos, 0 sin ninguna).
+
+alter table public.facturas drop constraint facturas_entidad_unica;
+
+alter table public.facturas
+  add constraint facturas_entidad_unica
+  check (num_nonnulls(recibo_id, venta_pos_id) <= 1);
+
+comment on constraint facturas_entidad_unica on public.facturas is
+  'Una factura cuelga como mucho de UNA entidad. Las dos a la vez no tiene sentido; ninguna sí lo tiene: es el caso de la RECTIFICATIVA, que rectifica a otra factura (rectifica_a) y no a un cobro.';
diff --git a/supabase/migrations/20260902120100_revoke_grants_vestigiales_authenticated.sql b/supabase/migrations/20260902120100_revoke_grants_vestigiales_authenticated.sql
