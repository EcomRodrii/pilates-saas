# Auditoría 2026-09-16 (DEB-3): no existía ningún `.env.example`, y 99
# variables distintas se usan en el código sin que ninguna quede documentada
# en un solo sitio. Esto es solo la lista y el motivo de cada una — NO valida
# nada en arranque (ver `lib/app-url.ts`): hacer que faltar una lance un error
# exige primero confirmar en Vercel que las 99 están puestas en los tres
# entornos, y eso es una tanda aparte.
#
# Copia este fichero a `.env.local` y rellena los valores reales. Nunca
# commitees `.env.local` (ya está en `.gitignore`).

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App / entorno ────────────────────────────────────────────────────────────
# Sin esta variable (o mal escrita), cualquier enlace generado en servidor
# (email, `success_url` de Stripe...) apunta a localhost. Ver `lib/app-url.ts`.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Secretos de cron / rutas internas ────────────────────────────────────────
CRON_SECRET=
SUPABASE_CRON_SECRET=
OAUTH_STATE_SECRET=
HOME_PREVIEW_TOKEN_SECRET=
SUSTITUCION_TOKEN_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────────
# `sk_test_XXXX` = «sin configurar», NO «modo test» — ver
# `lib/billing/modo-stripe.ts` y `docs/STRIPE-MODO-TEST.md`.
STRIPE_SECRET_KEY=sk_test_XXXX
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PLATFORM_ACCOUNT_ID=
STRIPE_PRICE_BASE=
STRIPE_PRICE_ESTUDIO=
STRIPE_PRICE_CADENA=
TENTARE_APPLICATION_FEE_BPS=

# ── Correo (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=

# ── Correo saliente propio (backoffice /interno) ─────────────────────────────
SPACEMAIL_USER=
SPACEMAIL_PASSWORD=
SPACEMAIL_FROM=

# ── Push (Web Push / VAPID) ───────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tentare.app

# ── Turnstile (captcha) ───────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Sentry ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── PostHog (analítica) ───────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_KEY=
POSTHOG_HOST=

# ── Cloudflare R2 (backups) ───────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Cloudflare Stream (vídeo, feature-freeze) ────────────────────────────────
CLOUDFLARE_STREAM_TOKEN=
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_CODE=

# ── Integraciones — Google (Calendar/Gmail) ──────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SITE_VERIFICATION=

# ── Integraciones — Zoom ─────────────────────────────────────────────────────
NEXT_PUBLIC_ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── Integraciones — Klaviyo ───────────────────────────────────────────────────
NEXT_PUBLIC_KLAVIYO_CLIENT_ID=
KLAVIYO_CLIENT_SECRET=

# ── Integraciones — Meta (WhatsApp Embedded Signup) ──────────────────────────
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=

# ── Veri*Factu (Fiskaly) ──────────────────────────────────────────────────────
FISKALY_API_KEY=
FISKALY_API_SECRET=
FISKALY_ENV=
NEXT_PUBLIC_VERIFACTU_ENTORNO=
VERIFACTU_ENTORNO=
VERIFACTU_VERSION_SISTEMA=
VERIFACTU_ID_SISTEMA=
VERIFACTU_NUM_INSTALACION=
VERIFACTU_PRODUCTOR_NIF=
VERIFACTU_PRODUCTOR_NOMBRE=
VERIFACTU_TIPO_CERTIFICADO=
VERIFACTU_CERT_PFX_BASE64=
VERIFACTU_CERT_PASSPHRASE=

# ── IA (Decision OS, asistentes) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── SEO ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_AHREFS_KEY=

# ── Importador CSV/plataformas ────────────────────────────────────────────────
NEXT_PUBLIC_IMPORTS_HOST=

# ── Billing (flag interno) ───────────────────────────────────────────────────
BILLING_ENFORCED=
