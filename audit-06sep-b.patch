diff --git a/lib/student/cadena-rechazo-salto0.test.ts b/lib/student/cadena-rechazo-salto0.test.ts
new file mode 100644
index 00000000..3ef0e3b8
--- /dev/null
+++ b/lib/student/cadena-rechazo-salto0.test.ts
@@ -0,0 +1,100 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync, readdirSync } from 'node:fs';
+import { join } from 'node:path';
+
+// SALTO 0 — el eslabon que faltaba: la RPC contra el TypeScript.
+//
+// Por que existe. El `codigo` con el que se rechaza una reserva atraviesa
+// cuatro saltos —`reservar_plaza` (SQL) → `crearReservaPublica` (escalera de
+// ifs) → `/api/public/reserva` → `reserva-codigos.ts` (union + switch)— y
+// NINGUNO esta tipado contra el siguiente. Anadir un `raise exception` en una
+// migracion no rompe la compilacion ni pone ningun test en rojo: el sintoma
+// aparece cuando una socia se lo encuentra.
+//
+// Ya paso tres veces en cinco dias:
+//   · `sin-plan` / `bono-no-cubre` (4-sep) — la alumna sin bono leia «algo no
+//     ha salido bien» con un boton que fallaba igual.
+//   · `RESERVA_BLOQUEADA_IMPAGO` (#1664, 5-sep) — mismo sintoma. Confirmado en
+//     produccion con una socia real: Sentry JAVASCRIPT-NEXTJS-26, 6-sep 03:25,
+//     `codigo: "impago"`, con su mensaje redactado a mano recortado por el
+//     camino porque el codigo no estaba en `CODIGOS_DE_NEGOCIO`.
+//   · `ESTUDIO_CERRADO` (#1665, 5-sep) — idem, sin llegar a reportarse.
+//
+// El test del 4-sep no lo impidio porque nombraba los tres codigos que ya
+// conocia. Un test que enumera ejemplares no cierra una familia. Este no
+// nombra ninguno: DERIVA la lista del SQL y exige que cada eslabon la cubra.
+// Anadir un `raise exception` nuevo sin cablearlo deja este test en rojo.
+//
+// Es un test ESTRUCTURAL (lee el fuente) por la misma razon que sus vecinos
+// `cadena-rechazo-reserva.test.ts` y `crons-paginacion.test.ts`: ni las rutas
+// de Next ni la RPC se pueden importar desde el runner.
+
+const raiz = join(import.meta.dirname, '..', '..');
+const leer = (p: string) => readFileSync(join(raiz, p), 'utf8');
+
+/** La ultima migracion que (re)define `reservar_plaza` es la que manda. */
+function migracionVigenteDeReservarPlaza(): { fichero: string; sql: string } {
+  const dir = join(raiz, 'supabase', 'migrations');
+  const candidatos = readdirSync(dir)
+    .filter(f => f.endsWith('.sql'))
+    .sort()
+    .filter(f => /function\s+(public\.)?reservar_plaza/.test(readFileSync(join(dir, f), 'utf8')));
+  assert.ok(candidatos.length > 0, 'ninguna migracion define reservar_plaza');
+  const fichero = candidatos[candidatos.length - 1];
+  return { fichero, sql: readFileSync(join(dir, fichero), 'utf8') };
+}
+
+test('salto 0: todo `raise exception` de reservar_plaza tiene brazo en crearReservaPublica', () => {
+  const { fichero, sql } = migracionVigenteDeReservarPlaza();
+  const lanzados = [...new Set([...sql.matchAll(/raise\s+exception\s+'([A-Z_]+)'/g)].map(m => m[1]))];
+  assert.ok(lanzados.length >= 10, `esperaba la lista completa de rechazos, encontre ${lanzados.length}`);
+
+  const escalera = leer('lib/db/supabase-data-admin.ts');
+  const sinBrazo = lanzados.filter(n => !escalera.includes(`includes('${n}')`));
+  assert.deepEqual(
+    sinBrazo, [],
+    `Estos rechazos los LANZA ${fichero} y la escalera de crearReservaPublica no los reconoce, `
+    + `asi que caen en el comodin \`codigo: 'error'\`: la alumna lee el copy generico de averia `
+    + `con un boton de reintentar que va a fallar siempre, y cada intento levanta un evento de `
+    + `nivel error en Sentry. Anade su brazo en lib/db/supabase-data-admin.ts.`,
+  );
+});
+
+test('salto 0 bis: todo `codigo` que emite el servidor existe en el contrato del cliente', () => {
+  const escalera = leer('lib/db/supabase-data-admin.ts');
+  // Sin anclar a `return {`: los rechazos tambien viajan en ternarios, y ese
+  // fue justo el agujero del test anterior (no veia `sin-plan` ni
+  // `bono-no-cubre`, los dos del fix que decia proteger).
+  const emitidos = [...new Set([...escalera.matchAll(/codigo:\s*'([a-z-]+)'/g)].map(m => m[1]))];
+  assert.ok(emitidos.length >= 12, `esperaba los codigos de reserva, encontre ${emitidos.length}`);
+
+  const contrato = leer('lib/student/reserva-codigos.ts');
+  const union = contrato.slice(
+    contrato.indexOf('export type CodigoReserva'),
+    contrato.indexOf('const CODIGOS_DE_NEGOCIO'),
+  );
+  const negocio = contrato.slice(
+    contrato.indexOf('const CODIGOS_DE_NEGOCIO'),
+    contrato.indexOf('export function esRechazoConocido'),
+  );
+
+  const fueraDeLaUnion = emitidos.filter(c => !union.includes(`'${c}'`));
+  assert.deepEqual(
+    fueraDeLaUnion, [],
+    'Estos codigos los emite el servidor y no estan en `CodigoReserva`. TypeScript no lo detecta '
+    + 'porque la respuesta viaja serializada por HTTP.',
+  );
+
+  // 'error' es el comodin de averia: queda fuera a proposito, es lo unico que
+  // SI debe reportarse a Sentry.
+  const noReconocidos = emitidos.filter(c => c !== 'error' && !negocio.includes(`'${c}'`));
+  assert.deepEqual(
+    noReconocidos, [],
+    'Estos codigos son rechazos de NEGOCIO (el servidor les redacta un mensaje a mano) pero no '
+    + 'estan en CODIGOS_DE_NEGOCIO. Consecuencia doble y silenciosa: `esRechazoConocido` los da '
+    + 'por averia, asi que (1) lib/student/reservar.ts RECORTA el mensaje y la alumna lee el copy '
+    + 'generico en vez de lo que le escribimos, y (2) cada rechazo normal levanta un evento de '
+    + 'nivel error en Sentry.',
+  );
+});
